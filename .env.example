# Server-side secrets — injected by the proxies (api/morning.js, api/notion.js,
# server.js). These are NEVER bundled into the browser/client code.
#
# Local dev: copy this file to ".env" and fill in real values (server.js loads it
#   via dotenv). The ".env" file is gitignored.
# Production (Vercel): set these as Environment Variables in the project settings
#   (Settings → Environment Variables), NOT in this file.

# Morning / Green Invoice OAuth 2.0 API key (client credentials)
MORNING_ID=your-morning-client-id
MORNING_SECRET=your-morning-client-secret

# Notion integration token
NOTION_API_KEY=your-notion-internal-integration-secret
